# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL 13 or newer
DATABASE_URL=postgresql://finvista:change_me@localhost:5432/finvista
# Set to true if your host requires TLS (most cloud providers do)
DATABASE_SSL=false
# Optional: a separate, disposable database used ONLY by `npm test` for DB tests.
# Its tables are dropped and recreated, so never point this at real data.
TEST_DATABASE_URL=

# Login sessions last this many days
SESSION_TTL_DAYS=7
# Set true only when running behind a reverse proxy you control (so client IPs are read correctly)
TRUST_PROXY=false
# Rate limits (defaults shown): general API requests per IP per minute, and login/register/password
# attempts per IP per window (failed logins only)
API_RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15

# AI advisor (Milestone 10) uses Groq's FREE plan: no credit card, no billing.
# Get a key at https://console.groq.com/keys. Backend-only; never sent to the browser. Leave empty to disable the advisor.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: low | medium | high (low = fastest, uses the fewest free-plan tokens)
GROQ_REASONING_EFFORT=low
# Optional: reply budget in tokens (free plan: 8,000 tokens per minute) and request timeout in ms
GROQ_MAX_OUTPUT_TOKENS=1500
GROQ_TIMEOUT_MS=30000
# Advisor questions allowed per user per hour
ADVISOR_MAX_PER_HOUR=20
# Optional: only for a proxy or a local fake server in tests
GROQ_API_BASE_URL=

# Docker Compose only (docker-compose.yml): password for the bundled PostgreSQL container
POSTGRES_PASSWORD=
